{
  "name": "cricmotion-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Frictionless AI Video Generator for Cricket Reels & Shorts",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
